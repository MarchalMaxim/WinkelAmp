{
  "name": "winkelamp",
  "private": true,
  "version": "0.1.0",
  "description": "A studio for visual music: a recording becomes a show of canvas widgets set off by its notes.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && vitest run --project fast",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "e2e": "node scripts/studio-check.mjs",
    "picker-check": "node scripts/checks/picker-check.mjs",
    "fidelity": "node scripts/fidelity.mjs",
    "ears": "tsx scripts/ears/server.ts",
    "ingest": "tsx scripts/ingest.ts",
    "augment-pack": "tsx scripts/augment-pack.ts",
    "lab-notes": "tsx scripts/lab-notes.ts",
    "check-show": "tsx scripts/check-show.ts",
    "describe-song": "tsx scripts/describe-song.ts",
    "widget-docs": "tsx scripts/widget-docs.ts",
    "widget-thumbs": "node lab/thumbs.mjs",
    "widget-demos": "node lab/demos.mjs",
    "render-show": "node scripts/render-show.mjs",
    "setup-ymt3": "tsx scripts/setup-ymt3.ts",
    "setup-muscriptor": "tsx scripts/setup-muscriptor.ts"
  },
  "devDependencies": {
    "onnxruntime-node": "^1.31.1",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "onnxruntime-web": "^1.31.1"
  }
}
