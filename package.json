{
  "name": "winkelamp",
  "private": true,
  "version": "0.1.0",
  "description": "A synesthesia player: turns sound and rhythm into movement and color.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "shots": "node scripts/screenshots.mjs",
    "check-script": "tsx scripts/check-script.ts",
    "cast": "tsx scripts/cast-table.ts",
    "study": "tsx scripts/study.ts",
    "preview-script": "node scripts/preview-script.mjs",
    "ingest": "tsx scripts/ingest.ts",
    "ears": "tsx scripts/ears/server.ts",
    "fidelity": "node scripts/fidelity.mjs",
    "check-show": "tsx scripts/check-show.ts",
    "describe-song": "tsx scripts/describe-song.ts",
    "widget-docs": "tsx scripts/widget-docs.ts",
    "widget-thumbs": "node lab/thumbs.mjs",
    "widget-demos": "node lab/demos.mjs",
    "studio-check": "node scripts/studio-check.mjs",
    "record-check": "node scripts/record-check.mjs",
    "render-show": "node scripts/render-show.mjs",
    "setup-ymt3": "tsx scripts/setup-ymt3.ts",
    "setup-muscriptor": "tsx scripts/setup-muscriptor.ts",
    "pianoroll": "node scripts/pianoroll.mjs",
    "hd-check": "node scripts/hd-check.mjs",
    "persist-probe": "node scripts/persist-probe.mjs",
    "lab-notes": "tsx scripts/lab-notes.ts",
    "runtime-check": "node scripts/checks/runtime-layers-check.mjs",
    "layers-check": "node scripts/checks/layers-check.mjs",
    "overlay-check": "node scripts/checks/overlay-check.mjs",
    "lanes-check": "node scripts/checks/lanes-check.mjs",
    "picks-check": "node scripts/checks/picks-check.mjs",
    "picker-check": "node scripts/checks/picker-check.mjs",
    "redo-check": "node scripts/checks/redo-check.mjs"
  },
  "devDependencies": {
    "onnxruntime-node": "^1.31.1",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "onnxruntime-web": "^1.31.1"
  }
}
