node_modules
dist
*.log
.DS_Store
.superpowers/

# The lab plays local recordings; their audio and the notes transcribed from them stay out of git.
lab/*.mp3
lab/*.wav
lab/*.ogg
lab/notes*.js
# The lab's per-song pack data (npm run lab-notes): tracks, beats and loudness computed from the recordings.
lab/pack-*.js

# Widget demo clips (npm run widget-demos): rendered, local only.
lab/demos/*.mp4

# Song packs (npm run ingest): the recordings and everything computed from them, local only.
songs/

# Videos from npm run render-show and recordings: they carry the recordings, local only.
renders/
